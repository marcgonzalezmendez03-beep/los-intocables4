# Archivo de ejemplo: copia a .env. Nunca publiques .env en GitHub.
CLUB_NAME=Los Intocables
REFRESH_MINUTES=5
# auto: consulta EA en la web y también acepta envíos del bot; bot: solo envíos del bot
DATA_SOURCE=auto
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_UNICA
SESSION_SECRET=GENERA_UN_SECRETO_ALEATORIO_MUY_LARGO
HUB_SYNC_TOKEN=GENERA_UN_TOKEN_ALEATORIO_MUY_LARGO
COOKIE_SECURE=false
# Persistencia: en Render con disco, por ejemplo /var/data/site.db
# DATABASE_PATH=site.db
