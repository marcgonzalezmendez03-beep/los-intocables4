# Pon el nombre exacto del club tal como aparece en EA.
CLUB_NAME=Los Intocables

# Token del bot de Discord (déjalo vacío para probar solo la web).
DISCORD_TOKEN=PEGA_AQUI_TU_TOKEN_NUEVO
# ID numérico del canal donde publicar avisos.
DISCORD_CHANNEL_ID=0

# Actualización cada 5 minutos (mínimo recomendado por este proyecto).
REFRESH_MINUTES=5
PORT=8000

# Conexión opcional a la web HUB
HUB_URL=https://los-intocables.onrender.com
HUB_SYNC_TOKEN=PEGA_EL_MISMO_TOKEN_SEGURO_DEL_HUB
